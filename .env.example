# Company3D configuration. Copy to `.env` (never commit it) and fill in.
#
# Leave the three GitHub/URL values empty to run in LOCAL mode: a single user, on localhost,
# acting through your GitHub CLI (`gh auth login`).
#
# Set all three to run in HOSTED mode: everyone signs in with GitHub and every GitHub call uses
# their own token, so they only see and do what their GitHub account allows.

# Public origin people use to reach the app (no path). Must be https:// in production.
PUBLIC_URL=

# From your GitHub App (recommended) or OAuth App settings page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: your GitHub App's URL name, to show an "install the app on your org" link.
GITHUB_APP_SLUG=

# Optional: subscriptions with Stripe (hosted mode). Set all three to require a paid plan per organization.
# Use test-mode keys (sk_test_...) until you're ready to charge for real.
STRIPE_SECRET_KEY=
# The Price ID of the plan (price_..., e.g. R$25.00 per month), not the product ID.
STRIPE_PRICE_ID=
# Signing secret of the webhook endpoint PUBLIC_URL/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Organizations that never need a subscription (comma-separated), e.g. your own company.
COMPLIMENTARY_ORGS=

# Optional: only open buildings for these organizations (comma-separated). Empty = any org where
# the signed-in person is a member (and, with a GitHub App, where the app is installed).
ALLOWED_ORGS=

# Network. Hosted mode listens on 0.0.0.0 by default, local mode on 127.0.0.1.
PORT=3000
HOST=

# Set to 1 when running behind a reverse proxy/load balancer that sets X-Forwarded-For
# (used for rate limiting). Leave unset when the app is exposed directly.
TRUST_PROXY=

# Where settings (floor order, repo connections) are stored. Default: ./data
DATA_DIR=

# Classic OAuth App only (ignored by GitHub Apps). Default: "read:org repo".
GITHUB_OAUTH_SCOPES=
