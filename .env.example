# Worktown3D web app configuration. Copy to `.env` (never commit it) and fill in.
# Sign-in, GitHub, Stripe and database settings belong to the API (worktown3d-api), not here.

# Public origin people open the app at (no path), the same value as the API's PUBLIC_URL.
# Leave empty to run locally: the app then only answers on localhost.
PUBLIC_URL=

# Where the Worktown3D API listens (plain http, reachable only by this server). Default: http://127.0.0.1:3001
# On Railway, use the API's private address, e.g. http://${{worktown3d-api.RAILWAY_PRIVATE_DOMAIN}}:8080
API_URL=

# Network. Default port 3000. With PUBLIC_URL set it listens on all interfaces, otherwise on 127.0.0.1.
PORT=3000
HOST=
